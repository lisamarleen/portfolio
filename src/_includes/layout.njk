<!doctype html>
<html lang="en" class="no-js">
<head>
  <meta charset="utf-8">
  <meta content="initial-scale=1, width=device-width" name="viewport">
  <title>{{pageTitle }}</title>

  <style>
    {{ pageId | cssmin | safe }}
    {{ "main" | cssmin | safe }}
  </style>
  <script>
    {{ pageId | jsmin | safe }}
  </script>
  <link rel="stylesheet" href="/css/main.css">
  <script src="/js/main.js" defer></script>
</head>

<body style="background-color: #030110; margin: 0; padding: 0;">

  <main>
   {{ content | safe }}
   
    <nav class="exit-nav">
      <div class="content-wrapper">
          <ul class="exit-nav-list" data-page-animation-fade-in-view>
              {% for navigationItem in common.navigation %}
                  <li class="exit-nav-list__item">
                      <a href={{navigationItem.link}}>{{navigationItem.label}}</a>
                  </li>
              {% endfor %}
          </ul>
        </div>
    </nav>

    <section class="social">
      <div class="content-wrapper">
        <div class="social-content">
          <h2 class="social-content__title">{{ common.social.title }}</h2>
          <ul class="social-content__list social-list">
            {% for socialItem in common.social.items %}
              <li class="social-list__item">
                <a href={{ socialItem.link }} class="social-list__link{% if socialItem.highlighted %} social-list__link--highlighted{% endif %}" rel="noopener noreferrer" target="_blank">
                  {{ socialItem.label }}
                  {% if socialItem.highlighted %} {% include "underline-deco.njk" %}{% endif %}
                </a>
              </li>
            {% endfor %}
          </ul>
        </div>
      </div>
    </section>

    <footer class="footer">
      <small class="footer__copyright">{{ common.footer.copyright }}</small>
      <a class="footer__link" href={{ common.footer.imprint.link }} rel="noopener noreferrer" target="_blank">
        {{ common.footer.imprint.label }}
      </a>
    </footer>
  </main>
  
</body>
</html>