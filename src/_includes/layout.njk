    <meta property="og:url" content="www.stateofthedeep.art" />
    <meta property="og:title" content="Entomon" />
    <meta
      property="og:description"
      content="This Project is an attempt to use deep learning as a tool to question human representation. Human faces and their humanist understanding of the “natural” are modified with facial features of unwanted bodies. Influenced by posthuman visions, the aim is to overcome a binary worldview and embrace hybrid futures and diverse bodies."
    />
    <meta
      property="og:image"
      content="http://www.stateofthedeep.art/share/social-share-image.jpg"
    />
    <meta property="og:image:width" content="1024" />
    <meta property="og:image:height" content="1024" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Entomon" />
    <meta
      name="twitter:description"
      content="This Project is an attempt to use deep learning as a tool to question human representation. Human faces and their humanist understanding of the “natural” are modified with facial features of unwanted bodies. Influenced by posthuman visions, the aim is to overcome a binary worldview and embrace hybrid futures and diverse bodies."
    />
    <meta
      name="twitter:image"
      content="http://www.stateofthedeep.art/share/social-share-image.jpg"
    />

  <style>
    {{ pageId | cssmin | safe }}
    {{ "main" | cssmin | safe }}
  </style>
  <script>
    {{ "main" | jsmin | safe }}
    {{ pageId | jsmin | safe }}
  </script>
  <link rel="stylesheet" href="{{ "/css/main.css" | url }}">
  <script src="{{ "/js/main.js" | url }}" defer></script>
</head>

<body style="background-color: #030110; margin: 0; padding: 0;">

