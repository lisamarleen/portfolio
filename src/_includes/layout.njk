<!doctype html>
<html lang="en" class="no-js">
<head>
  <title>{{pageTitle }}</title>
  <meta charset="utf-8">
  <meta content="initial-scale=1, width=device-width" name="viewport">
  <meta name="theme-color" content="#030110" />
  <meta name="description" content={{ pageDescription }} />

  
    <link rel="apple-touch-icon" sizes="57x57" href={{ "/assets/app-images/apple-icon-57x57.png" | url }} />
    <link rel="apple-touch-icon" sizes="60x60" href={{ "/assets/app-images/apple-icon-60x60.png" | url }} />
    <link rel="apple-touch-icon" sizes="72x72" href={{ "/assets/app-images/apple-icon-72x72.png" | url }} />
    <link rel="apple-touch-icon" sizes="76x76" href={{ "/assets/app-images/apple-icon-76x76.png" | url }} />
    <link
      rel="apple-touch-icon"
      sizes="114x114"
      href={{ "/assets/app-images/apple-icon-114x114.png" | url }}
    />
    <link
      rel="apple-touch-icon"
      sizes="120x120"
      href={{ "/assets/app-images/apple-icon-120x120.png" | url }}
    />
    <link
      rel="apple-touch-icon"
      sizes="144x144"
      href={{ "/assets/app-images/apple-icon-144x144.png" | url }}
    />
    <link
      rel="apple-touch-icon"
      sizes="152x152"
      href={{ "/assets/app-images/apple-icon-152x152.png" | url }}
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href={{ "/assets/app-images/apple-icon-180x180.png" | url }}
    />
    <link
      rel="icon"
      type="image/png"
      sizes="192x192"
      href={{ "/assets/app-images/android-icon-192x192.png" | url }}
    />
    <link rel="icon" type="image/png" sizes="32x32" href={{ "/assets/app-images/favicon-32x32.png" | url }} />
    <link rel="icon" type="image/png" sizes="96x96" href={{ "/assets/app-images/favicon-96x96.png" | url }} />
    <link rel="icon" type="image/png" sizes="16x16" href={{ "/assets/app-images/favicon-16x16.png" | url }} />
    <link rel="manifest" href={{ "/assets/app-images/manifest.json" | url }} />

    <meta property="og:url" content="www.stateofthedeep.art" />
    <meta property="og:title" content="Entomon" />
    <meta
      property="og:description"
      content="This Project is an attempt to use deep learning as a tool to question human representation. Human faces and their humanist understanding of the “natural” are modified with facial features of unwanted bodies. Influenced by posthuman visions, the aim is to overcome a binary worldview and embrace hybrid futures and diverse bodies."
    />
    <meta
      property="og:image"
      content="http://www.stateofthedeep.art/share/social-share-image.jpg"
    />
    <meta property="og:image:width" content="1024" />
    <meta property="og:image:height" content="1024" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Entomon" />
    <meta
      name="twitter:description"
      content="This Project is an attempt to use deep learning as a tool to question human representation. Human faces and their humanist understanding of the “natural” are modified with facial features of unwanted bodies. Influenced by posthuman visions, the aim is to overcome a binary worldview and embrace hybrid futures and diverse bodies."
    />
    <meta
      name="twitter:image"
      content="http://www.stateofthedeep.art/share/social-share-image.jpg"
    />

  <style>
    {{ pageId | cssmin | safe }}
    {{ "main" | cssmin | safe }}
  </style>
  <script>
    {{ "main" | jsmin | safe }}
    {{ pageId | jsmin | safe }}
  </script>
  <link rel="stylesheet" href="{{ "/css/main.css" | url }}">
  <script src="{{ "/js/main.js" | url }}" defer></script>
</head>

<body style="background-color: #030110; margin: 0; padding: 0;">

  <main>
   {{ content | safe }}

    <section class="social">
      <div class="content-wrapper">
        <div class="social-content">
          <h2 class="social-content__title">{{ common.social.title }}</h2>
          <ul class="social-content__list social-list">
            {% for socialItem in common.social.items %}
              <li class="social-list__item">
                <a 
                  href={{ socialItem.link }} 
                  class="social-list__link{% if socialItem.highlighted %} social-list__link--highlighted{% endif %} external-link" 
                  rel="noopener noreferrer" 
                  target="_blank">
                  {{ socialItem.label }}
                  {% if socialItem.highlighted %} 
                    {% include "underline-deco.njk" %}
                  {% endif %}
                </a>
              </li>
            {% endfor %}
          </ul>
        </div>
      </div>
    </section>

    <footer class="footer">
      <small class="footer__copyright">{{ common.footer.copyright }}</small>
      <a class="footer__link" href={{ common.footer.imprint.link }} rel="noopener noreferrer" target="_blank">
        {{ common.footer.imprint.label }}
      </a>
    </footer>
  </main>
  
</body>
</html>