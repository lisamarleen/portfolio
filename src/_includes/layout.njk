    </a>
  </header>

  <main>
   {{ content | safe }}

    <section class="social">
      <div class="content-wrapper">
        <div class="social-content">
          <h2 class="social-content__title">{{ common.social.title }}</h2>
          <ul class="social-content__list social-list">
            {% for socialItem in common.social.items %}
              <li class="social-list__item">
                <a 
                  href={{ socialItem.link }} 
                  class="social-list__link external-link" 
                  rel="noopener noreferrer" 
                  target="_blank">
                  {{ socialItem.label }}
                </a>
              </li>
            {% endfor %}
          </ul>
          <div class="social-content__email">
            <a 
              href={{ common.social.email.link }} 
              class="social-list__link external-link" 
              rel="noopener noreferrer" 
              target="_blank">
              {{ common.social.email.label }}
              {% include "underline-deco.njk" %}
            </a>
          </div>

        </div>
      </div>
    </section>

    <footer class="footer">
      <small class="footer__copyright">{{ common.footer.copyright }}</small>
      <a class="footer__link" href={{ common.footer.imprint.link }} rel="noopener noreferrer" target="_blank">
        {{ common.footer.imprint.label }}
      </a>
    </footer>
  </main>
  
</body>
</html>