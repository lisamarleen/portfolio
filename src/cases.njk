---
layout: layout.njk
pageId: cases
pageTitle: "Lisa Marleen Portfolio 2022 - Cases"
---

<div class="page-intro" data-page-animation-container>
    <h1 class="page-intro__title" data-page-animation-title>{{ cases.title | safe }}</h1>
</div>
<div class="tabs">
    <ul class="tabs-list tabs-list--sticky" data-page-animation-content>
        <li class="tabs-list__item">
            <a class="tabs-list__link" href="#independent">{{ cases.tabs.leftTitle }}</a>
            {% include "underline-deco.njk" %}
        </li>
        <li class="tabs-list__item">
            <a class="tabs-list__link" href="#incommision">{{ cases.tabs.rightTitle }}</a>
            {% include "underline-deco.njk" %}
        </li>
    </ul>
    <section class="tabs-panel" id="independent">
        {% for caseItem in independent.items %}
            <div class="case-section">
                <div class="content-wrapper">
                    <div class="case">
                        {% for caseImage in caseItem.images %}
                            {% set computedSrc = "./src/assets/images/" + caseItem.id + "/" + caseImage.src  %}
                            <div 
                                class="case__visual visual visual--alignment-{{ caseImage.largeView.alignment | default('left') }} visual--width-{{ caseImage.largeView.width | default('1/1') }}" 
                                data-page-animation-image>
                                {%  imageWithDetail computedSrc, caseImage.alt, "(min-width: 768px) 50vw, 100vw" %}
                            </div>
                        {% endfor %}
                        <h2 class="case__title" data-page-animation-fade-in-view>{{ caseItem.title | safe }}</h2>
                        <div class="case__desc" data-page-animation-fade-in-view>
                            <div class="formatted-copy">{{ caseItem.description | safe }}</div>
                            <div class="case-links">
                                {% for caseLink in caseItem.links %}
                                    <a class="case-links__item external-link" href={{ caseLink.link }} rel="noopener noreferrer" target="_blank">
                                        {{ caseLink.label }}
                                        {% include "icon-arrow-right-up.njk" %}
                                    </a>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
        <nav class="exit-nav">
            <div class="content-wrapper">
                <ul class="exit-nav-list" data-page-animation-fade-in-view>
                {% for navigationItem in cases.exitNavigationIndependent %}
                    <li class="exit-nav-list__item">
                        <a href={{navigationItem.link}}>
                            {{navigationItem.label}}
                            {% if navigationItem.isSkipLink %}{% include "icon-arrow-up-scribbled.njk" %}{% endif %}
                        </a>
                    </li>
                {% endfor %}
                </ul>
            </div>
        </nav>
    </section>
    <section class="tabs-panel" id="incommision">
        {% for caseItem in commercial.items %}
            <div class="case-section">
                <div class="content-wrapper">
                    <div class="case">
                        {% for caseImage in caseItem.images %}
                            {% set computedSrc = "./src/assets/images/" + caseItem.id + "/" + caseImage.src  %}
                            <div 
                                data-page-animation-image
                                class="visual visual--alignment-{{ caseImage.largeView.alignment | default('left') }} visual--width-{{ caseImage.largeView.width | default('1/1') }}">
                                {%  imageWithDetail computedSrc, caseImage.alt, "(min-width: 768px) 50vw, 100vw" %}
                            </div>
                        {% endfor %}
                        <h2 class="case__title" data-page-animation-fade-in-view>{{ caseItem.title | safe }}</h2>
                        <div class="case__desc" data-page-animation-fade-in-view data-in-view-amount="0.5">
                            <div class="formatted-copy">{{ caseItem.description | safe }}</div>
                            <div class="case-links">
                                {% for caseLink in caseItem.links %}
                                    <a class="case-links__item external-link" href={{ caseLink.link }} rel="noopener noreferrer" target="_blank">
                                        {{ caseLink.label }}
                                        {% include "icon-arrow-right-up.njk" %}
                                    </a>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
        <nav class="exit-nav">
            <div class="content-wrapper">
                <ul class="exit-nav-list" data-page-animation-fade-in-view>
                {% for navigationItem in cases.exitNavigationInCommision %}
                    <li class="exit-nav-list__item">
                        <a href={{navigationItem.link}}>
                            {{navigationItem.label}}
                            {% if navigationItem.isSkipLink %}{% include "icon-arrow-up-scribbled.njk" %}{% endif %}
                        </a>
                    </li>
                {% endfor %}
                </ul>
            </div>
        </nav>
    </section>
</div>
